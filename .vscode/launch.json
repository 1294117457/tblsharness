{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "stopOnEntry": false,
      "timeout": 120,
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/harness-cursor"
      ],
      "outFiles": ["${workspaceFolder}/harness-cursor/dist/**/*.js"],
      "preLaunchTask": "build-harness"
    }
  ]
}
