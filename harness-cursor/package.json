{
  "name": "harness-cursor",
  "displayName": "Harness",
  "description": "以 tbls JSON 为统一格式，对照数据模型的设计与数据库的实际结构",
  "version": "0.0.5",
  "publisher": "harness",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://example.com/harness/harness-cursor.git"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "harness.workspace.create",
        "title": "新建工作区",
        "category": "Harness",
        "icon": "$(add)"
      },
      {
        "command": "harness.workspace.rename",
        "title": "重命名工作区",
        "category": "Harness"
      },
      {
        "command": "harness.workspace.delete",
        "title": "删除工作区",
        "category": "Harness"
      },
      {
        "command": "harness.workspace.add",
        "title": "新建…",
        "category": "Harness",
        "icon": "$(add)"
      },
      {
        "command": "harness.edit",
        "title": "编辑…",
        "category": "Harness",
        "icon": "$(edit)"
      },
      {
        "command": "harness.refresh",
        "title": "刷新",
        "category": "Harness",
        "icon": "$(refresh)"
      },
      {
        "command": "harness.openStorage",
        "title": "打开存储目录",
        "category": "Harness",
        "icon": "$(folder-opened)"
      },
      {
        "command": "harness.design.create",
        "title": "新建设计库",
        "category": "Harness",
        "icon": "$(add)"
      },
      {
        "command": "harness.design.createBlank",
        "title": "空白",
        "category": "Harness"
      },
      {
        "command": "harness.design.createFromDb",
        "title": "从数据库复制…",
        "category": "Harness"
      },
      {
        "command": "harness.design.createFromFile",
        "title": "从 tbls JSON 文件导入…",
        "category": "Harness"
      },
      {
        "command": "harness.design.setDriver",
        "title": "目标数据库类型…",
        "category": "Harness"
      },
      {
        "command": "harness.rename",
        "title": "重命名",
        "category": "Harness"
      },
      {
        "command": "harness.design.openRaw",
        "title": "打开 schema.json",
        "category": "Harness"
      },
      {
        "command": "harness.design.openExt",
        "title": "打开 ext.json",
        "category": "Harness"
      },
      {
        "command": "harness.design.rename",
        "title": "重命名设计库",
        "category": "Harness"
      },
      {
        "command": "harness.design.delete",
        "title": "删除设计库",
        "category": "Harness"
      },
      {
        "command": "harness.design.open",
        "title": "打开设计画布",
        "category": "Harness",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "harness.design.copyForAI",
        "title": "复制给 AI（格式说明 + 表结构）",
        "category": "Harness",
        "icon": "$(copy)"
      },
      {
        "command": "harness.export.open",
        "title": "导出…",
        "category": "Harness",
        "icon": "$(export)"
      },
      {
        "command": "harness.export.pickPath",
        "title": "选择导出位置…",
        "category": "Harness",
        "icon": "$(folder-opened)"
      },
      {
        "command": "harness.export.run",
        "title": "执行导出",
        "category": "Harness",
        "icon": "$(export)"
      },
      {
        "command": "harness.diagram.create",
        "title": "新建设计图…",
        "category": "Harness",
        "icon": "$(add)"
      },
      {
        "command": "harness.diagram.open",
        "title": "在画布中定位",
        "category": "Harness"
      },
      {
        "command": "harness.diagram.openInTab",
        "title": "在单独标签页中打开",
        "category": "Harness"
      },
      {
        "command": "harness.diagram.openText",
        "title": "以文本打开",
        "category": "Harness"
      },
      {
        "command": "harness.diagram.copyForAI",
        "title": "复制给 AI",
        "category": "Harness",
        "icon": "$(copy)"
      },
      {
        "command": "harness.diagram.rename",
        "title": "重命名设计图",
        "category": "Harness"
      },
      {
        "command": "harness.diagram.delete",
        "title": "删除设计图",
        "category": "Harness"
      },
      {
        "command": "harness.db.create",
        "title": "添加数据库",
        "category": "Harness",
        "icon": "$(add)"
      },
      {
        "command": "harness.db.sync",
        "title": "同步数据库结构",
        "category": "Harness",
        "icon": "$(sync)"
      },
      {
        "command": "harness.db.editConnection",
        "title": "编辑连接…",
        "category": "Harness"
      },
      {
        "command": "harness.db.clearConnection",
        "title": "清除已保存的连接",
        "category": "Harness"
      },
      {
        "command": "harness.db.importSnapshot",
        "title": "导入快照文件…",
        "category": "Harness"
      },
      {
        "command": "harness.db.importTblsConfig",
        "title": "导入 tbls 配置（.tbls.yml）…",
        "category": "Harness"
      },
      {
        "command": "harness.db.openConfig",
        "title": "编辑配置（source.yml）",
        "category": "Harness"
      },
      {
        "command": "harness.db.openSnapshot",
        "title": "打开最新快照",
        "category": "Harness"
      },
      {
        "command": "harness.db.delete",
        "title": "删除数据库",
        "category": "Harness"
      },
      {
        "command": "harness.tbls.checkUpdate",
        "title": "检查 tbls 更新",
        "category": "Harness",
        "icon": "$(sync)"
      },
      {
        "command": "harness.tbls.repair",
        "title": "下载并修复内置 tbls",
        "category": "Harness",
        "icon": "$(cloud-download)"
      },
      {
        "command": "harness.tbls.openFolder",
        "title": "打开内置 tbls 文件夹",
        "category": "Harness",
        "icon": "$(folder-opened)"
      },
      {
        "command": "harness.tbls.status",
        "title": "查看当前使用的 tbls",
        "category": "Harness",
        "icon": "$(info)"
      },
      {
        "command": "harness.partition.open",
        "title": "在画布中定位",
        "category": "Harness"
      },
      {
        "command": "harness.partition.create",
        "title": "新建分区画布",
        "category": "Harness",
        "icon": "$(add)"
      },
      {
        "command": "harness.partition.rename",
        "title": "重命名分区画布",
        "category": "Harness"
      },
      {
        "command": "harness.partition.delete",
        "title": "删除分区画布",
        "category": "Harness"
      },
      {
        "command": "harness.partition.setNamespace",
        "title": "命名空间…",
        "category": "Harness"
      },
      {
        "command": "harness.item.copy",
        "title": "复制",
        "category": "Harness"
      },
      {
        "command": "harness.item.cut",
        "title": "剪切",
        "category": "Harness"
      },
      {
        "command": "harness.item.paste",
        "title": "粘贴",
        "category": "Harness"
      },
      {
        "command": "harness.source.addToCanvas",
        "title": "添加到画布…",
        "category": "Harness",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "harness.table.revealInCanvas",
        "title": "在画布中定位",
        "category": "Harness",
        "icon": "$(target)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harness",
          "title": "Harness",
          "icon": "media/harness.svg"
        }
      ]
    },
    "views": {
      "harness": [
        {
          "id": "harness.workspaces",
          "name": "工作区"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "harness.workspaces",
        "contents": "工作区用来组织设计画布和数据库结构。不需要连接数据库，也可以直接开始设计。\n[新建工作区](command:harness.workspace.create)\n工作区保存在插件自己的存储目录中，不会写入你的项目。"
      }
    ],
    "customEditors": [
      {
        "viewType": "harness.canvas",
        "displayName": "Harness 画布",
        "selector": [
          {
            "filenamePattern": "**/design/*/layout.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "harness.diagram",
        "displayName": "Harness 设计图",
        "selector": [
          {
            "filenamePattern": "**/diagrams/diagram*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "submenus": [
      {
        "id": "harness.design.newMenu",
        "label": "新建设计库"
      }
    ],
    "keybindings": [
      {
        "command": "harness.rename",
        "key": "f2",
        "when": "focusedView == harness.workspaces"
      },
      {
        "command": "harness.item.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == harness.workspaces"
      },
      {
        "command": "harness.item.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == harness.workspaces"
      },
      {
        "command": "harness.item.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == harness.workspaces && harness.clipboard"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "harness.workspace.create",
          "when": "view == harness.workspaces",
          "group": "navigation@1"
        },
        {
          "command": "harness.refresh",
          "when": "view == harness.workspaces",
          "group": "navigation@2"
        },
        {
          "command": "harness.openStorage",
          "when": "view == harness.workspaces",
          "group": "9_storage"
        }
      ],
      "view/item/context": [
        {
          "command": "harness.edit",
          "when": "view == harness.workspaces && viewItem =~ /^(workspace|design|partition)$/",
          "group": "inline@9"
        },
        {
          "command": "harness.edit",
          "when": "view == harness.workspaces && viewItem =~ /^(workspace|design|partition)$/",
          "group": "9_manage@0"
        },
        {
          "command": "harness.partition.create",
          "when": "view == harness.workspaces && viewItem == levelGroup.partitions",
          "group": "inline"
        },
        {
          "command": "harness.partition.create",
          "when": "view == harness.workspaces && viewItem =~ /^(design|partition|levelGroup\\.partitions)$/",
          "group": "2_edit@2"
        },
        {
          "command": "harness.partition.open",
          "when": "view == harness.workspaces && viewItem == partition",
          "group": "1_open@0"
        },
        {
          "command": "harness.partition.setNamespace",
          "when": "view == harness.workspaces && viewItem == partition",
          "group": "2_edit@3"
        },
        {
          "command": "harness.partition.rename",
          "when": "view == harness.workspaces && viewItem == partition",
          "group": "9_manage@1"
        },
        {
          "command": "harness.partition.delete",
          "when": "view == harness.workspaces && viewItem == partition",
          "group": "9_manage@2"
        },
        {
          "command": "harness.item.copy",
          "when": "view == harness.workspaces && viewItem =~ /^(partition|diagram|table\\.design)$/",
          "group": "5_clipboard@1"
        },
        {
          "command": "harness.item.cut",
          "when": "view == harness.workspaces && viewItem =~ /^(partition|diagram|table\\.design)$/",
          "group": "5_clipboard@2"
        },
        {
          "command": "harness.item.paste",
          "when": "view == harness.workspaces && harness.clipboard && viewItem =~ /^(design|partition|levelGroup\\..*)$/",
          "group": "5_clipboard@3"
        },
        {
          "command": "harness.workspace.add",
          "when": "view == harness.workspaces && viewItem == workspace",
          "group": "inline"
        },
        {
          "submenu": "harness.design.newMenu",
          "when": "view == harness.workspaces && (viewItem == workspace || viewItem == group.design)",
          "group": "1_new@1"
        },
        {
          "command": "harness.db.create",
          "when": "view == harness.workspaces && viewItem == workspace",
          "group": "1_new@2"
        },
        {
          "command": "harness.workspace.rename",
          "when": "view == harness.workspaces && viewItem == workspace",
          "group": "9_manage@1"
        },
        {
          "command": "harness.workspace.delete",
          "when": "view == harness.workspaces && viewItem == workspace",
          "group": "9_manage@2"
        },
        {
          "command": "harness.design.create",
          "when": "view == harness.workspaces && viewItem == group.design",
          "group": "inline"
        },
        {
          "command": "harness.db.create",
          "when": "view == harness.workspaces && viewItem == group.db",
          "group": "inline"
        },
        {
          "command": "harness.design.open",
          "when": "view == harness.workspaces && viewItem =~ /^(design|levelGroup\\.tables)$/",
          "group": "1_open@0"
        },
        {
          "command": "harness.design.openRaw",
          "when": "view == harness.workspaces && viewItem == design",
          "group": "1_open@2"
        },
        {
          "command": "harness.design.openExt",
          "when": "view == harness.workspaces && viewItem == design",
          "group": "1_open@3"
        },
        {
          "command": "harness.design.copyForAI",
          "when": "view == harness.workspaces && viewItem == design",
          "group": "1_open@4"
        },
        {
          "command": "harness.export.open",
          "when": "view == harness.workspaces && viewItem == design",
          "group": "1_open@5"
        },
        {
          "command": "harness.diagram.create",
          "when": "view == harness.workspaces && viewItem =~ /^(design|partition|levelGroup\\.diagrams)$/",
          "group": "2_edit@0"
        },
        {
          "command": "harness.diagram.create",
          "when": "view == harness.workspaces && viewItem == levelGroup.diagrams",
          "group": "inline"
        },
        {
          "command": "harness.diagram.copyForAI",
          "when": "view == harness.workspaces && viewItem == diagram",
          "group": "inline"
        },
        {
          "command": "harness.diagram.open",
          "when": "view == harness.workspaces && viewItem == diagram",
          "group": "1_open@1"
        },
        {
          "command": "harness.diagram.openInTab",
          "when": "view == harness.workspaces && viewItem == diagram",
          "group": "1_open@2"
        },
        {
          "command": "harness.diagram.openText",
          "when": "view == harness.workspaces && viewItem == diagram",
          "group": "1_open@3"
        },
        {
          "command": "harness.diagram.copyForAI",
          "when": "view == harness.workspaces && viewItem == diagram",
          "group": "1_open@3"
        },
        {
          "command": "harness.diagram.rename",
          "when": "view == harness.workspaces && viewItem == diagram",
          "group": "9_manage@1"
        },
        {
          "command": "harness.diagram.delete",
          "when": "view == harness.workspaces && viewItem == diagram",
          "group": "9_manage@2"
        },
        {
          "command": "harness.design.setDriver",
          "when": "view == harness.workspaces && viewItem == design",
          "group": "2_edit@1"
        },
        {
          "command": "harness.design.rename",
          "when": "view == harness.workspaces && viewItem == design",
          "group": "9_manage@1"
        },
        {
          "command": "harness.design.delete",
          "when": "view == harness.workspaces && viewItem == design",
          "group": "9_manage@2"
        },
        {
          "command": "harness.db.sync",
          "when": "view == harness.workspaces && viewItem == db.connected",
          "group": "inline"
        },
        {
          "command": "harness.db.sync",
          "when": "view == harness.workspaces && viewItem =~ /^db\\./",
          "group": "1_sync@1"
        },
        {
          "command": "harness.db.editConnection",
          "when": "view == harness.workspaces && viewItem =~ /^db\\./",
          "group": "1_sync@2"
        },
        {
          "command": "harness.db.clearConnection",
          "when": "view == harness.workspaces && viewItem == db.connected",
          "group": "1_sync@3"
        },
        {
          "command": "harness.db.importSnapshot",
          "when": "view == harness.workspaces && viewItem =~ /^db\\./",
          "group": "2_import@1"
        },
        {
          "command": "harness.db.importTblsConfig",
          "when": "view == harness.workspaces && viewItem =~ /^db\\./",
          "group": "2_import@2"
        },
        {
          "command": "harness.source.addToCanvas",
          "when": "view == harness.workspaces && viewItem =~ /^db\\./",
          "group": "3_open@1"
        },
        {
          "command": "harness.db.openSnapshot",
          "when": "view == harness.workspaces && viewItem =~ /^db\\./",
          "group": "3_open@2"
        },
        {
          "command": "harness.db.openConfig",
          "when": "view == harness.workspaces && viewItem =~ /^db\\./",
          "group": "3_open@3"
        },
        {
          "command": "harness.db.delete",
          "when": "view == harness.workspaces && viewItem =~ /^db\\./",
          "group": "9_manage@2"
        },
        {
          "command": "harness.table.revealInCanvas",
          "when": "view == harness.workspaces && viewItem =~ /^table\\./",
          "group": "inline"
        },
        {
          "command": "harness.table.revealInCanvas",
          "when": "view == harness.workspaces && viewItem =~ /^table\\./",
          "group": "1_open@1"
        },
        {
          "command": "harness.source.addToCanvas",
          "when": "view == harness.workspaces && viewItem == table.db",
          "group": "1_open@2"
        }
      ],
      "harness.design.newMenu": [
        {
          "command": "harness.design.createBlank",
          "group": "1_new@1"
        },
        {
          "command": "harness.design.createFromDb",
          "group": "1_new@2"
        },
        {
          "command": "harness.design.createFromFile",
          "group": "1_new@3"
        }
      ],
      "commandPalette": [
        {
          "command": "harness.source.addToCanvas",
          "when": "false"
        },
        {
          "command": "harness.table.revealInCanvas",
          "when": "false"
        },
        {
          "command": "harness.rename",
          "when": "false"
        },
        {
          "command": "harness.edit",
          "when": "false"
        },
        {
          "command": "harness.design.createBlank",
          "when": "false"
        },
        {
          "command": "harness.partition.open",
          "when": "false"
        },
        {
          "command": "harness.partition.rename",
          "when": "false"
        },
        {
          "command": "harness.partition.delete",
          "when": "false"
        },
        {
          "command": "harness.partition.setNamespace",
          "when": "false"
        },
        {
          "command": "harness.item.copy",
          "when": "false"
        },
        {
          "command": "harness.item.cut",
          "when": "false"
        },
        {
          "command": "harness.item.paste",
          "when": "false"
        },
        {
          "command": "harness.export.open",
          "when": "false"
        },
        {
          "command": "harness.export.pickPath",
          "when": "false"
        },
        {
          "command": "harness.export.run",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Harness",
      "properties": {
        "harness.tblsPath": {
          "type": "string",
          "default": "",
          "description": "tbls 可执行文件路径。留空时使用 Harness 内置的 tbls；可以填 PATH 里的命令名（如 tbls），也可以填绝对路径。填了之后 Harness 会先运行一次 `tbls --version` 确认它真的能用。"
        },
        "harness.tblsDownloadBaseUrl": {
          "type": "string",
          "default": "https://github.com/k1LoW/tbls/releases/download",
          "description": "下载内置 tbls 时的基地址，必须指向 <仓库>/releases/download（少了 /download 会 404）。仅在 harness.tblsPath 留空时生效。"
        },
        "harness.tblsVersion": {
          "type": "string",
          "default": "",
          "description": "内置 tbls 的版本（带不带 v 都可以），如 1.96.1。留空时使用 Harness 打包时验证过的版本。注意这和扩展自身的版本号无关。仅在 harness.tblsPath 留空时生效。"
        },
        "harness.tblsAutoDownload": {
          "type": "boolean",
          "default": true,
          "description": "首次使用时是否自动下载并使用内置的 tbls。关闭后只在你显式选择“下载 tbls”时下载。"
        },
        "harness.storageDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "工作区的存储目录（绝对路径）。留空时使用插件自己的存储目录。可以改到网盘或 Git 仓库里做备份和同步；连接信息（主机、用户名、密码）始终保存在系统凭据中，不会写入这个目录。"
        },
        "harness.tblsTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "description": "读取数据库结构（tbls）的最长时间，超过后停止。"
        }
      }
    }
  },
  "scripts": {
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build --config webview-ui/vite.config.mts",
    "build": "npm run build:ext && npm run build:webview",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --config webview-ui/vite.config.mts --watch",
    "dev:webview": "vite --config webview-ui/vite.config.mts",
